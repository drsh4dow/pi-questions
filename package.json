{
	"name": "pi-questions",
	"version": "0.3.4",
	"description": "Minimal ask_questions tool for Pi",
	"type": "module",
	"author": "drsh4dow <daniel.morettiv@gmail.com> (https://codeberg.org/drsh4dow)",
	"repository": {
		"type": "git",
		"url": "git+https://codeberg.org/drsh4dow/pi-questions.git"
	},
	"bugs": {
		"url": "https://codeberg.org/drsh4dow/pi-questions/issues"
	},
	"homepage": "https://codeberg.org/drsh4dow/pi-questions#readme",
	"scripts": {
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"test": "bun test",
		"typecheck": "bunx tsc --noEmit"
	},
	"keywords": [
		"pi-package",
		"pi",
		"questions",
		"tui",
		"minimal",
		"structured-input"
	],
	"files": [
		"extensions",
		"README.md"
	],
	"pi": {
		"extensions": [
			"./extensions/ask-questions.ts"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.3",
		"@earendil-works/pi-coding-agent": "^0.80.6",
		"@earendil-works/pi-tui": "^0.80.6",
		"@types/bun": "^1.3.14",
		"typebox": "^1.3.6",
		"typescript": "^7.0.2"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"overrides": {
		"brace-expansion": "5.0.7",
		"ws": "8.21.0"
	},
	"trustedDependencies": [
		"koffi",
		"protobufjs"
	]
